# Environment Configuration

# Application Settings
APP_NAME=FaceRecogApp
APP_ENV=development
LOG_LEVEL=info

# Feature Flags
ENABLE_CLOUD_SYNC=false
ENABLE_ENCRYPTION=true
ENABLE_DEBUG_LOGS=false

# AI/ML Settings
MODEL_CONFIDENCE_THRESHOLD=0.85
LIVENESS_THRESHOLD=0.90
ENROLLMENT_FRAMES_REQUIRED=3

# API Configuration
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000

# AWS Configuration (for cloud sync - optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DYNAMODB_TABLE_USERS=FaceRecogApp_Users
AWS_DYNAMODB_TABLE_ATTENDANCE=FaceRecogApp_Attendance
AWS_S3_BUCKET=facerecogapp-backups
AWS_LAMBDA_ENDPOINT=https://your-lambda-endpoint.amazonaws.com

# Database Configuration
DATABASE_NAME=facerecog.db
DATABASE_ENCRYPTION_ENABLED=true
DATABASE_ENCRYPTION_KEY=your_encryption_key_here

# Performance Settings
IMAGE_CACHE_SIZE=50
CONCURRENT_INFERENCE_TASKS=1
BACKGROUND_SYNC_INTERVAL=3600000

# Camera Settings
CAMERA_RESOLUTION=high
CAMERA_FRAME_RATE=30
FACE_DETECTION_SENSITIVITY=high

# Offline Sync Settings
ENABLE_OFFLINE_FIRST=true
AUTO_SYNC_WHEN_ONLINE=true
SYNC_BATCH_SIZE=50
CONFLICT_RESOLUTION_STRATEGY=keep_cloud_version

# Security Settings
ENABLE_BIOMETRIC_ENCRYPTION=true
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=90
SENSITIVE_DATA_MASKING=true

# Error Handling
ERROR_REPORTING_ENABLED=true
ERROR_LOG_RETENTION_DAYS=30
CRASH_REPORTING_URL=https://your-error-tracking-service.com

# Development Only
MOCK_CAMERA_DATA=false
SKIP_LIVENESS_IN_DEV=false
VERBOSE_ML_LOGS=false
